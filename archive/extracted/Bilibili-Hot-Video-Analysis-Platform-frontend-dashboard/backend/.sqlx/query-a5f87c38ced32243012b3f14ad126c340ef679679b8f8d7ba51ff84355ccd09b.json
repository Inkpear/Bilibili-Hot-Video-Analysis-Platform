  "query": "SELECT DISTINCT\n            u.up_id,\n            u.up_name,\n            u.follower_count,\n            u.hot_video_count,\n            u.total_views\n        FROM ads_up_summary u\n        JOIN ads_hot_video_rank h ON h.up_name = u.up_name\n        WHERE h.category = ?\n        ORDER BY u.total_views DESC\n        LIMIT 10",
