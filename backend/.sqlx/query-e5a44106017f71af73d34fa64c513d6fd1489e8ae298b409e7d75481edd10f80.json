  "query": "SELECT\n            bvid,\n            title,\n            category,\n            snapshot_date,\n            DATE_FORMAT(FROM_UNIXTIME(collect_time DIV 1000), '%H:%i') AS snapshot_time,\n            view_count,\n            like_count,\n            rank_position,\n            rank_source,\n            rank_name,\n            COALESCE(view_count - LAG(view_count) OVER (ORDER BY collect_time), 0) AS view_growth,\n            COALESCE(LAG(rank_position) OVER (ORDER BY collect_time) - rank_position, 0) AS rank_change\n        FROM hot_video\n        WHERE bvid = ?\n        ORDER BY collect_time ASC",
