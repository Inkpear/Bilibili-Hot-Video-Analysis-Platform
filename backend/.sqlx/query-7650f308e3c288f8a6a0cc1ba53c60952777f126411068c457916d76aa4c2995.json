{
  "db_name": "MySQL",
  "query": "SELECT\n                    c.bvid, h.title, h.category, h.up_name, c.user_name, c.content,\n                    CAST(c.like_count AS SIGNED) AS like_count,\n                    CAST(c.reply_count AS SIGNED) AS reply_count,\n                    DATE_FORMAT(FROM_UNIXTIME(c.comment_time DIV 1000), '%Y-%m-%d %H:%i:%s') AS `comment_time: String`\n                FROM comment_info c\n                JOIN hot_video h ON c.bvid = h.bvid AND c.snapshot_date = h.snapshot_date\n                WHERE c.bvid = ? AND h.snapshot_date = (SELECT MAX(snapshot_date) FROM snapshot_dates)\n                ORDER BY c.like_count DESC\n                LIMIT ?",
