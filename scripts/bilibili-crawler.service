[Unit]
Description=Bilibili Hot Video Crawler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=BILI_COOKIE=%i
ExecStart=/home/inkpear/crawler-v2/target/release/bilibili-crawler
WorkingDirectory=/home/inkpear/crawler-v2
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
