[Unit]
Description=Bilibili Backend API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=DATABASE_URL=mysql://root:root@127.0.0.1:3306/bilibili
ExecStart=/home/inkpear/backend/target/release/bilibili-hot-backend
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
