[Unit]
Description=B站热门视频采集
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/crawler
EnvironmentFile=%h/crawler/.env
ExecStart=/usr/bin/python3 %h/crawler/main.py --once
ExecStartPost=/bin/bash %h/scripts/run_pipeline.sh
StandardOutput=journal
StandardError=journal
